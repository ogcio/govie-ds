{
  "name": "@ogcio/examples-vue",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "typecheck": "vue-tsc -p tsconfig.app.json --noEmit",
    "format": "prettier 'src/**/*.{ts,vue}' --write",
    "format:check": "prettier 'src/**/*.{ts,vue}' --check"
  },
  "dependencies": {
    "@ogcio/design-system-vue": "workspace:*",
    "@ogcio/theme-govie": "workspace:*",
    "lodash": "^4.18.1",
    "vue": "3.5.39"
  },
  "devDependencies": {
    "@ogcio/design-system-tailwind": "workspace:*",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "tailwindcss": "3.4.14",
    "typescript": "^5.9.3",
    "vite": "8.0.12",
    "vue-tsc": "3.3.6"
  }
}
