{
  "name": "@ogcio/design-system-inspector",
  "private": true,
  "version": "0.1.0",
  "description": "Overlay that highlights Government of Ireland Design System components on a page and links to their documentation.",
  "type": "module",
  "exports": {
    ".": "./dist/inspector.js"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@ogcio/design-system-react": "workspace:*",
    "@ogcio/design-system-tailwind": "workspace:*",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwindcss": "3.4.14",
    "typescript": "^5.9.3",
    "vite": "8.0.12"
  }
}
