{
  "name": "@ogcio/design-system-core",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "pnpm run build:react && pnpm run build:angular && pnpm run build:vue",
    "build:react": "NODE_OPTIONS='--import tsx' mitosis build --config react.config.ts",
    "build:angular": "NODE_OPTIONS='--import tsx' mitosis build --config angular.config.ts",
    "build:vue": "NODE_OPTIONS='--import tsx' mitosis build --config vue.config.ts",
    "build:watch": "chokidar \"./atoms/**/*.{ts,tsx}\" -c \"pnpm run build\" --initial",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "lodash": "^4.18.1",
    "storybook": "^10.3.3",
    "tailwind-variants": "^0.2.1"
  },
  "devDependencies": {
    "@builder.io/eslint-plugin-mitosis": "^0.0.17",
    "@builder.io/mitosis": "^0.13.0",
    "@builder.io/mitosis-cli": "^0.13.0",
    "@prettier/sync": "^0.6.1",
    "@types/lodash": "^4.17.24",
    "chokidar-cli": "^3.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
