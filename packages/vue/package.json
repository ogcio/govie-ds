{
  "name": "@ogcio/design-system-vue",
  "version": "0.1.0",
  "description": "The Government of Ireland Design System Vue components.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons.d.ts",
      "import": "./dist/icons.js"
    },
    "./logos": {
      "types": "./dist/logos.d.ts",
      "import": "./dist/logos.js"
    },
    "./styles.css": "./dist/styles.css",
    "./fonts.css": "./fonts.css"
  },
  "scripts": {
    "build": "pnpm build:ts && pnpm build:styles",
    "build:ts": "vite build && vue-tsc -p tsconfig.build.json",
    "build:styles": "tailwindcss -i ./styles.css -o ./dist/styles.css --minify",
    "typecheck": "vue-tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "files": [
    "dist",
    "fonts.css"
  ],
  "peerDependencies": {
    "lodash": "^4.0.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@fontsource/lato": "^5.1.1",
    "tailwind-variants": "0.2.1"
  },
  "devDependencies": {
    "@ogcio/design-system-tailwind": "workspace:*",
    "@types/lodash": "^4.17.24",
    "@vitejs/plugin-vue": "6.0.7",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint-plugin-vue": "^10.9.2",
    "lodash": "^4.18.1",
    "storybook": "10.3.5",
    "tailwindcss": "3.4.14",
    "typescript": "^5.9.3",
    "vite": "8.0.12",
    "vue": "3.5.39",
    "vue-tsc": "3.3.6"
  }
}
