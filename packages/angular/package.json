{
  "name": "@ogcio/design-system-angular",
  "private": true,
  "version": "0.3.0",
  "description": "The Government of Ireland Design System Angular components.",
  "keywords": [
    "angular",
    "design-system",
    "components",
    "govie",
    "ogcio"
  ],
  "homepage": "https://ds.services.gov.ie/",
  "bugs": "https://github.com/ogcio/govie-ds/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ogcio/govie-ds.git",
    "directory": "packages/angular"
  },
  "license": "MIT",
  "author": "Office of the Government Chief Information Officer",
  "type": "module",
  "exports": {
    "./fonts.css": "./fonts.css",
    "./styles.css": "./styles.css"
  },
  "publishConfig": {
    "directory": "dist",
    "linkDirectory": true
  },
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json && pnpm build:styles",
    "build:styles": "tailwindcss -i ./styles.css -o ./dist/styles.css --minify",
    "storybook:dev": "ng run design-system-angular:storybook",
    "storybook:build": "ng run design-system-angular:build-storybook",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "@angular/common": ">=19.0.0 <22.0.0",
    "@angular/core": ">=19.0.0 <22.0.0",
    "lodash": "^4.0.0"
  },
  "dependencies": {
    "@fontsource/lato": "^5.1.1",
    "tailwind-variants": "0.2.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.7.2",
    "@angular-devkit/architect": "~0.2102.0",
    "@angular-devkit/build-angular": "~21.2.0",
    "@angular-devkit/core": "~21.2.0",
    "@angular/animations": "^21.2.0",
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@ogcio/design-system-tailwind": "workspace:*",
    "@ogcio/theme-govie": "workspace:*",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/addon-links": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/angular-vite": "10.6.0",
    "@types/lodash": "^4.17.7",
    "@vitest/browser-playwright": "4.1.10",
    "angular-eslint": "^21.4.0",
    "autoprefixer": "^10.4.23",
    "eslint-config-prettier": "^10.1.8",
    "lodash": "^4.18.1",
    "ng-packagr": "^21.2.0",
    "postcss": "^8.5.14",
    "postcss-import": "^16.1.1",
    "rxjs": "~7.8.0",
    "storybook": "10.6.0",
    "storybook-addon-pseudo-states": "10.6.0",
    "tailwindcss": "3.4.14",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "8.0.12",
    "vitest": "4.1.10"
  }
}
